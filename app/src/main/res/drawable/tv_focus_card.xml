<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1D2B42" />
            <stroke android:width="3dp" android:color="#38BDF8" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#17253B" />
            <stroke android:width="2dp" android:color="#0EA5E9" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121824" />
            <stroke android:width="1dp" android:color="#263449" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
